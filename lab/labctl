def print_table(rows, headers):
    widths = [max(len(str(r[i])) for r in rows + [headers]) for i in range(len(headers))]
    for row in [headers] + rows:
        print('  '.join(str(c).ljust(w) for c, w in zip(row, widths)).rstrip())


def main(argv=None):
    parser = argparse.ArgumentParser(prog='labctl', description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--config', help='private config (default: $WAVE_LAB_CONFIG or nearest .lab/config.json)')
    parser.add_argument('-v', '--verbose', action='store_true')
    parser.add_argument('-q', '--quiet', action='store_true', help='suppress fallback notes')
    sub = parser.add_subparsers(dest='cmd', required=True)

    def add(name, help_text, *vm_args):
        p = sub.add_parser(name, help=help_text, description=help_text)
        for arg in vm_args:
            p.add_argument(arg)
        return p

    add('list', 'list lab VMs and templates')
    p = add('clone', 'linked clone of a template', 'template', 'name')
    p.add_argument('--vmid', type=int)
    p.add_argument('--memory', type=int)
    p.add_argument('--cores', type=int)
    p.add_argument('--no-snapshot', action='store_true', help='skip the "clean-desktop" snapshot')
    p.add_argument('--start', action='store_true')
    p = add('start', 'start a VM', 'name')
    p.add_argument('--force', action='store_true', help='ignore max_running')
    p.add_argument('--wait', choices=['agent', 'ssh', 'gnome', 'desktop'])
    p = add('stop', 'shut a VM down (forced after the timeout)', 'name')
    p.add_argument('--hard', action='store_true')
    p.add_argument('--timeout', type=int, default=90)
    p = add('destroy', 'destroy a lab VM', 'name')
    p.add_argument('--template', action='store_true', help='allow destroying a template')
    p = add('snapshot', 'take a snapshot', 'name', 'snap')
    p.add_argument('--vmstate', action='store_true', help='include RAM (VM keeps running state)')
    p.add_argument('--description', default='')
    p = add('rollback', 'roll back to a snapshot', 'name', 'snap')
    p.add_argument('--start', action='store_true')
    add('snapshots', 'list snapshots', 'name')
    add('delsnapshot', 'delete a snapshot', 'name', 'snap')
    for name, text in [('run', 'run a shell command (SSH, else guest agent); quote it or put it after --')]:
        p = add(name, text, 'name')
        p.add_argument('--root', action='store_true', help='run as root (sudo / agent)')
        p.add_argument('--session', action='store_true', help='export the graphical session environment')
        p.add_argument('--via', choices=['auto', 'ssh', 'agent'], default='auto')
        p.add_argument('--timeout', type=int)
        p.add_argument('--stdin', action='store_true', help='pass our stdin to the command')
        p.add_argument('--json', action='store_true', help='print {via, exitcode, stdout, stderr}')
    p = add('push', 'copy a local file into the guest', 'name', 'local', 'remote')
    p.add_argument('--root', action='store_true')
    p.add_argument('--mode')
    p.add_argument('--via', choices=['auto', 'ssh', 'agent'], default='auto')
    p = add('pull', 'copy a guest file to the workstation', 'name', 'remote', 'local')
    p.add_argument('--root', action='store_true')
    p.add_argument('--via', choices=['auto', 'ssh', 'agent'], default='auto')
    add('screenshot', 'save the guest display as PNG (host-side, no guest network)', 'name', 'out')
    p = add('key', 'press key combinations, e.g. ctrl-alt-t ret super', 'name')
    p.add_argument('combos', nargs='+')
    p = add('type', 'type text with the US keyboard map', 'name', 'text')
    p.add_argument('--delay', type=float, default=0.03)
    p = add('click', 'click at screen pixel X Y (absolute tablet)', 'name')
    p.add_argument('x', type=int)
    p.add_argument('y', type=int)
    p.add_argument('--button', choices=['left', 'right', 'middle'], default='left')
    p.add_argument('--double', action='store_true')
    p = add('move', 'move the pointer to pixel X Y', 'name')
    p.add_argument('x', type=int)
    p.add_argument('y', type=int)
    p = add('scroll', 'scroll the wheel (positive = down)', 'name')
    p.add_argument('clicks', type=int)
    add('console', 'interactive serial console (exit with Ctrl+O)', 'name')
    p = add('serial', 'send to / read from the serial console non-interactively', 'name')
    p.add_argument('--send', default='', help='text to send; escapes like \\r are interpreted')
    p.add_argument('--read', type=float, default=3.0, help='seconds to read')
    p.add_argument('--until', default='', help='stop reading when this regex appears')
    p = add('wait', 'wait for agent, ip, ssh, greeter, session, gnome or desktop', 'name', 'what')
    p.add_argument('--timeout', type=int, default=300)
    add('ip', 'print the guest IPv4 address (guest agent)', 'name')
    p = add('ssh', 'interactive SSH session as the guest user', 'name')
    p = add('login-mode', 'switch the display manager (GDM, SDDM, LightDM) between autologin and password login', 'name')
    p.add_argument('mode', choices=['autologin', 'password'])
    p.add_argument('--reboot', action='store_true')
    for name in ('dm-login', 'gdm-login'):
        p = add(name, 'log in at the greeter (GDM, SDDM, LightDM) by typing the private password', 'name')
        p.add_argument('--timeout', type=int, default=180)
    p = add('build-packages', 'build .deb/.rpm/Arch packages in the builder VM', 'src', 'out')
    p.add_argument('--ref', default='HEAD', help='Git revision to archive (default HEAD)')
    p.add_argument('--worktree', action='store_true', help='tracked files as in the working tree')
    p.add_argument('--checks', action='store_true', help='also run fmt/test/clippy')
    p.add_argument('--keep-running', action='store_true')
    p = add('template-create', 'build a sealed desktop template from a cloud image')
    p.add_argument('distro', choices=sorted(DISTROS))
    p.add_argument('--vmid', type=int)
    p.add_argument('--name')
    p = add('template-seal', 'seal a running provisioned guest and convert it to a template', 'name')
    p.add_argument('distro', choices=sorted(DISTROS))

    argv = list(sys.argv[1:] if argv is None else argv)
    tail = []
    if '--' in argv:
        cut = argv.index('--')
        argv, tail = argv[:cut], argv[cut + 1:]
    # run/ssh take the rest as the guest command; quote it or put it after --.
    args, extra = parser.parse_known_args(argv)
    if args.cmd == 'run':
        args.command = extra + tail
    elif args.cmd == 'ssh':
        args.args = extra + tail
    elif extra or tail:
        parser.error('unrecognized arguments: %s' % ' '.join(extra + tail))
    try:
        cfg = Config(find_config(args.config))
        lab = Lab(cfg, verbose=args.verbose, quiet=args.quiet)
        return dispatch(lab, args)
    except LabError as exc:
        sys.stderr.write('labctl: %s\n' % exc)
        return 1
    except KeyboardInterrupt:
        return 130


def dispatch(lab, args):
    cmd = args.cmd
    if cmd == 'list':
        rows = [[vm['vmid'], vm.get('name', ''), 'template' if vm.get('template') else vm.get('status', ''),
                 '%d' % ((vm.get('maxmem') or 0) // 2 ** 20), vm.get('cpus', '')] for vm in lab.lab_vms()]
        print_table(rows, ['VMID', 'NAME', 'STATUS', 'MEM_MB', 'CPUS']) if rows else print('no lab VMs')
        return 0
    if cmd == 'template-create':
        vmid = template_create(lab, args.distro, args.vmid, args.name)
        print('template %d ready' % vmid)
        return 0
    if cmd == 'clone':
        vmid = lab.clone(args.template, args.name, args.vmid, args.memory, args.cores,
                         snapshot=None if args.no_snapshot else 'clean-desktop')
        print('cloned %s as %s (%d)' % (args.template, args.name, vmid))
        if args.start:
            lab.start(lab.resolve(vmid))
        return 0
    if cmd == 'build-packages':
        dest = build_packages(lab, args.src, args.out, args.ref, args.worktree, args.keep_running, args.checks)
        print(dest)
        return 0
    vm = lab.resolve(args.name)
    vmid = vm['vmid']
    if cmd == 'template-seal':
        template_seal(lab, vm, args.distro)
        print('template %d ready' % vmid)
    elif cmd == 'start':
        lab.start(vm, force=args.force)
        if args.wait:
            print(lab.wait(vm, args.wait))
    elif cmd == 'stop':
        lab.stop(vm, hard=args.hard, timeout=args.timeout)
    elif cmd == 'destroy':
        lab.destroy(vm, allow_template=args.template)
        print('destroyed %s (%d)' % (vm['name'], vmid))
    elif cmd == 'snapshot':
        extra = ['--vmstate', 1] if args.vmstate else []
        lab.qm('snapshot', vmid, args.snap, '--description', args.description, *extra, timeout=900)
    elif cmd == 'rollback':
        lab.qm('rollback', vmid, args.snap, *(['--start', 1] if args.start else []), timeout=900)
        lab.forget(vmid)
    elif cmd == 'snapshots':
        sys.stdout.write(lab.qm('listsnapshot', vmid))
    elif cmd == 'delsnapshot':
        lab.qm('delsnapshot', vmid, args.snap, timeout=900)
    elif cmd == 'run':
        command = args.command
        if not command:
            raise LabError('no command given')
        text = command[0] if len(command) == 1 else ' '.join(command)
        stdin = sys.stdin.buffer.read() if args.stdin else None
        rc, out, err, via = lab.guest_run(vm, text, root=args.root, session=args.session, via=args.via,
                                          timeout=args.timeout, stdin=stdin)
        if args.json:
            print(json.dumps({'via': via, 'exitcode': rc, 'stdout': out.decode(errors='replace'),
                              'stderr': err.decode(errors='replace')}))
        else:
            sys.stdout.buffer.write(out)
            sys.stderr.buffer.write(err)
        return rc if isinstance(rc, int) and 0 <= rc < 256 else 1
    elif cmd == 'push':
        via = lab.push(vm, args.local, args.remote, root=args.root, mode=args.mode, via=args.via)
        lab.note('pushed via %s' % via)
    elif cmd == 'pull':
        via = lab.pull(vm, args.remote, args.local, root=args.root, via=args.via)
        lab.note('pulled via %s' % via)
    elif cmd == 'screenshot':
        width, height = lab.screenshot(vm, args.out)
        print('%s %dx%d' % (args.out, width, height))
    elif cmd == 'key':
        lab.keys(vm, args.combos)
    elif cmd == 'type':
        lab.type_text(vm, args.text, args.delay)
    elif cmd == 'click':
        lab.pointer(vm, args.x, args.y, button=args.button, double=args.double)
    elif cmd == 'move':
        lab.pointer(vm, args.x, args.y)
    elif cmd == 'scroll':
        lab.scroll(vm, args.clicks)
    elif cmd == 'console':
        os.execvp('ssh', ['ssh', '-t', lab.cfg.host, 'qm', 'terminal', str(vmid)])
    elif cmd == 'serial':
        proc = lab.helper('serial', vmid, args.read, args.send, args.until, timeout=args.read + 60)
        sys.stdout.buffer.write(proc.stdout)
    elif cmd == 'wait':
        if args.what not in WAIT_TARGETS:
            raise LabError('wait for one of: %s' % ' '.join(WAIT_TARGETS))
        print(lab.wait(vm, args.what, timeout=args.timeout))
    elif cmd == 'ip':
        print(lab.agent_ip(vmid))
    elif cmd == 'ssh':
        ip = lab.ssh_target(vmid, refresh=True)
        extra = args.args
        os.execvp('ssh', lab.ssh_args(vmid, ip, tty=not extra, batch=False) + extra)
    elif cmd == 'login-mode':
        print(lab.login_mode(vm, args.mode, reboot=args.reboot))
    elif cmd in ('dm-login', 'gdm-login'):
        print(lab.dm_login(vm, timeout=args.timeout))
    return 0


if __name__ == '__main__':
    sys.exit(main())
