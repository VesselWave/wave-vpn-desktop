def source_tarball(src, ref, worktree, dest):
    """Write tracked source (never .git, ignored or private files) to dest; return metadata."""
    src = Path(src).resolve()
    meta = {'source': src.name}
    is_git = subprocess.run(['git', '-C', str(src), 'rev-parse', '--is-inside-work-tree'],
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).returncode == 0
    if is_git:
        rev = subprocess.check_output(['git', '-C', str(src), 'rev-parse', ref + '^{commit}']).decode().strip()
        meta['revision'] = rev
        meta['source_date_epoch'] = int(subprocess.check_output(
            ['git', '-C', str(src), 'show', '-s', '--format=%ct', rev]).decode())
        if worktree:
            files = subprocess.check_output(['git', '-C', str(src), 'ls-files', '-z']).decode().split('\0')
            dirty = subprocess.check_output(['git', '-C', str(src), 'status', '--porcelain',
                                             '--untracked-files=no']).decode().strip()
            meta['revision'] = rev + ('-dirty' if dirty else '')
            with tarfile.open(dest, 'w:gz') as tar:
                for rel in sorted(f for f in files if f):
                    path = src / rel
                    if path.is_file() and not path.is_symlink():
                        tar.add(str(path), arcname=rel, recursive=False)
        else:
            with open(dest, 'wb') as out:
                subprocess.run(['git', '-C', str(src), 'archive', '--format=tar.gz', rev], stdout=out,
                               check=True)
    else:
        meta['revision'] = 'unversioned'
        meta['source_date_epoch'] = int(time.time())
        skip = {'.git', 'target', 'node_modules', '.lab', '.reference'}

        def keep(info):
            parts = Path(info.name).parts
            if any(p in skip or p.startswith('.env') for p in parts):
                return None
            return info

        with tarfile.open(dest, 'w:gz') as tar:
            for child in sorted(src.iterdir()):
                tar.add(str(child), arcname=child.name, filter=keep)
    return meta


def build_packages(lab, src, out, ref='HEAD', worktree=False, keep_running=False, checks=False):
    cfg = lab.cfg
    bcfg = dict({'name': 'wave-builder', 'template': 'wave-tpl-ubuntu2404', 'cores': 4, 'memory_mb': 4096},
                **(cfg.builder or {}))
    out = Path(out).resolve()
    with tempfile.TemporaryDirectory() as tmp:
        tarball = Path(tmp) / 'source.tar.gz'
        meta = source_tarball(src, ref, worktree, tarball)
        names = {vm.get('name'): vm for vm in lab.lab_vms()}
        created = bcfg['name'] not in names
        if created:
            lab.note('creating builder %s from %s' % (bcfg['name'], bcfg['template']))
            lab.clone(bcfg['template'], bcfg['name'], memory=bcfg['memory_mb'], cores=bcfg['cores'],
                      snapshot=None)
        vm = lab.resolve(bcfg['name'])
        was_running = lab.status(vm['vmid']) == 'running'
        lab.start(vm)
        try:
            lab.wait(vm, 'ssh', timeout=600)
            if created:
                lab.push(vm, LAB_DIR / 'builder' / 'setup-ubuntu.sh', '/tmp/wave-builder-setup.sh')
                lab.note('installing the build toolchain')
                rc, _, err, _ = lab.guest_run(vm, 'bash /tmp/wave-builder-setup.sh', root=True, timeout=3600,
                                              stream=True)
                if rc != 0:
                    raise LabError('builder setup failed: %s' % err.decode(errors='replace')[-2000:])
                rc, _, err, _ = lab.guest_run(vm, 'bash /tmp/wave-builder-setup.sh user', timeout=3600,
                                              stream=True)
                if rc != 0:
                    raise LabError('Rust setup failed: %s' % err.decode(errors='replace')[-2000:])
                lab.qm('snapshot', vm['vmid'], 'toolchain', '--description', 'builder toolchain installed',
                       timeout=300)
            lab.push(vm, tarball, '/tmp/wave-source.tar.gz')
            lab.push(vm, LAB_DIR / 'builder' / 'build.sh', '/tmp/wave-build.sh')
            lab.note('building %s (%s)' % (meta['source'], meta['revision']))
            env = 'WAVE_REVISION=%s SOURCE_DATE_EPOCH=%d RUN_CHECKS=%d CARGO_BUILD_JOBS=%d' % (
                shlex.quote(meta['revision']), meta['source_date_epoch'], 1 if checks else 0, bcfg['cores'])
            rc, _, err, _ = lab.guest_run(vm, '%s bash /tmp/wave-build.sh /tmp/wave-source.tar.gz' % env,
                                          timeout=7200, stream=True)
            if rc != 0:
                raise LabError('build failed: %s' % err.decode(errors='replace')[-3000:])
            listing = lab.guest_run(vm, 'cd ~/build/out && ls -1')[1].decode().split()
            version = next((f.split('_')[1].rsplit('-', 1)[0] for f in listing if f.endswith('.deb')), 'unknown')
            dest = out / ('wave-vpn-%s-%s' % (version, meta['revision'][:12] + (
                '-dirty' if meta['revision'].endswith('-dirty') else '')))
            dest.mkdir(parents=True, exist_ok=True)
            for name in listing:
                lab.pull(vm, '/home/%s/build/out/%s' % (cfg.guest_user, name), dest / name)
            toolchain = lab.guest_run(vm, '. ~/.cargo/env && rustc -V && /usr/local/bin/nfpm --version | '
                                          'sed -n "s/^GitVersion: *//p"')[1].decode().split('\n')
            meta.update({'version': version, 'built': datetime.datetime.utcnow().isoformat() + 'Z',
                         'builder_template': bcfg['template'], 'rustc': toolchain[0].strip(),
                         'nfpm': (toolchain[1].strip() if len(toolchain) > 1 else ''), 'files': {}})
            for name in listing:
                meta['files'][name] = hashlib.sha256((dest / name).read_bytes()).hexdigest()
            (dest / 'BUILD.json').write_text(json.dumps(meta, indent=2) + '\n')
            return dest
        finally:
            if not keep_running and not was_running:
                lab.stop(vm)


