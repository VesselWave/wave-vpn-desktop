def image_digest(spec):
    """('sha256'|'sha512', hex) pinned for a distro image."""
    for algo in ('sha256', 'sha512'):
        if spec.get(algo):
            return algo, spec[algo]
    raise LabError('no pinned checksum for %s' % spec['image'])


def cpio_newc(files):
    """An uncompressed newc cpio archive of (name, bytes) regular files, for appending to an initrd."""
    out = b''
    for ino, (name, data, mode) in enumerate(list(files) + [('TRAILER!!!', b'', 0)], 1):
        raw = name.encode() + b'\0'
        fields = (ino, mode, 0, 0, 1, 0, len(data), 0, 0, 0, 0, len(raw), 0)
        rec = b'070701' + ''.join('%08X' % v for v in fields).encode() + raw
        rec += b'\0' * (-len(rec) % 4) + data + b'\0' * (-len(data) % 4)
        out += rec
    return out + b'\0' * (-len(out) % 512)


def _ubiquity_install(lab, vmid, name, spec, image, timeout=5400):
    """Install from an Ubuntu-family live ISO with automatic Ubiquity, then boot the disk.

    The live kernel is booted directly (QEMU -kernel) so the command line can ask
    for automatic-ubiquity; the preseed rides in an extra cpio appended to the
    ISO's initrd (casper loads /preseed.cfg from the initramfs). It creates the
    user with a crypted password and, via success_command, installs openssh-server
    and the guest agent and authorises the lab key. The working files are removed.
    """
    cfg, st, q = lab.cfg, lab.cfg.storage, shlex.quote
    work = '%s/installer-%d' % (cfg.image_dir, vmid)
    size_gb = int(spec['disk'].rstrip('G'))
    lab.qm('set', vmid, '--scsi0', '%s:%d,format=qcow2,discard=on,ssd=1,iothread=1' % (st, size_gb))
    crypted = lab.host_text('openssl passwd -6 -stdin', input=(cfg.password() + '\n').encode()).strip()
    if not crypted.startswith('$6$'):
        raise LabError('could not hash the guest password')
    pub = cfg.private(cfg.ssh_key + '.pub').read_text().strip()
    preseed = (LAB_DIR / spec['preseed']).read_text()
    for key, value in (('@USER@', cfg.guest_user), ('@HOSTNAME@', name), ('@CRYPTED@', crypted),
                       ('@SSHKEY@', pub)):
        preseed = preseed.replace(key, value)
    lab.host('install -d -m 700 %(w)s && isoinfo -i %(i)s -R -x /casper/vmlinuz > %(w)s/vmlinuz && '
             'isoinfo -i %(i)s -R -x /casper/initrd.lz > %(w)s/initrd && '
             'test -s %(w)s/vmlinuz && test -s %(w)s/initrd && '
             'truncate -s %%512 %(w)s/initrd && cat >> %(w)s/initrd' % {'w': q(work), 'i': q(image)},
             input=cpio_newc([('preseed.cfg', preseed.encode(), 0o100600)]), timeout=300)
    append = ('boot=casper automatic-ubiquity noprompt quiet splash console=ttyS0,115200 console=tty1 '
              'debian-installer/locale=en_US.UTF-8 keyboard-configuration/layoutcode=us --')
    lab.qm('set', vmid, '--ide2', '%s,media=cdrom' % image, '--boot', 'order=scsi0;ide2',
           '--args', '-kernel %s/vmlinuz -initrd %s/initrd -append %s' % (work, work, q(append)))
    shots = cfg.dir / 'artifacts'
    shots.mkdir(exist_ok=True)
    try:
        lab.note('installing from %s (automatic Ubiquity; watch with labctl screenshot %d)' % (spec['image'], vmid))
        lab.qm('start', vmid, timeout=180)
        vm = {'vmid': vmid, 'name': name}
        deadline = time.time() + timeout
        last_shot = 0
        while lab.status(vmid) == 'running':
            if time.time() > deadline:
                raise LabError('installer did not power off within %d s; see %s' % (
                    timeout, shots / ('%s-installer.png' % name)))
            if time.time() - last_shot > 60:
                try:
                    lab.screenshot(vm, shots / ('%s-installer.png' % name))
                except LabError:
                    pass
                last_shot = time.time()
            time.sleep(10)
    finally:
        lab.qm('set', vmid, '--delete', 'args,ide2', '--boot', 'order=scsi0')
        lab.host('rm -rf %s' % q(work))
    lab.note('installed; booting the new system')
    lab.qm('start', vmid, timeout=180)
    lab.wait({'vmid': vmid, 'name': name}, 'agent', timeout=600)
    lab.refresh_ssh(vmid)


def _cloud_first_boot(lab, vmid, spec, image):
    """Import a cloud image, boot it once with Proxmox cloud-init, pin its SSH host key."""
    cfg, st = lab.cfg, lab.cfg.storage
    lab.qm('set', vmid, '--scsi0', '%s:0,import-from=%s,format=qcow2,discard=on,ssd=1,iothread=1' % (
        st, image), timeout=900)
    lab.qm('resize', vmid, 'scsi0', spec['disk'])
    pub = cfg.private(cfg.ssh_key + '.pub').read_bytes()
    keyfile = '/tmp/wave-lab-%d.pub' % vmid
    lab.host('cat > %s' % keyfile, input=pub)
    lab.qm('set', vmid, '--ide2', '%s:cloudinit' % st, '--ciuser', cfg.guest_user, '--sshkeys', keyfile,
           '--ipconfig0', 'ip=dhcp', '--ciupgrade', 0, '--boot', 'order=scsi0')
    lab.host('rm -f %s' % keyfile)
    lab.note('first boot (cloud-init); watching the serial console for address and host key')
    lab.qm('start', vmid, timeout=180)
    console = lab.helper('serial', vmid, 600, '', spec.get('serial_until', 'END SSH HOST KEY KEYS'), timeout=700,
                         check=False).stdout.decode(errors='replace')
    (cfg.state_dir / ('%d-first-boot-console.txt' % vmid)).write_text(console)
    found = re.findall(r'ci-info: \|\s*(e\w+)\s*\|\s*True\s*\|\s*(\d+\.\d+\.\d+\.\d+)\s*\|', console)
    key = re.search(r'(ssh-ed25519 [A-Za-z0-9+/=]+)', console.split('BEGIN SSH HOST KEY KEYS')[-1])
    # Newer cloud-init may print its table before DHCP finishes: look the MAC up instead.
    ip = found[0][1] if found else lab.neighbor_ip(vmid)
    if key:
        lab.pin_host_key(vmid, ip, key.group(1))
        return
    # Some images (openSUSE) print no host keys and restrict the guest agent. Trust on
    # first use from the Proxmox host, which shares the guest's bridge.
    lab.note('no host key on the serial console; scanning it from the Proxmox host')
    for _ in range(30):
        out = lab.host_text('ssh-keyscan -T 5 -t ed25519 %s 2>/dev/null' % shlex.quote(ip), check=False)
        found_key = re.search(r'(ssh-ed25519 [A-Za-z0-9+/=]+)', out)
        if found_key:
            lab.pin_host_key(vmid, ip, found_key.group(1))
            return
        time.sleep(10)
    raise LabError('could not read the SSH host key (serial console or ssh-keyscan)')


def template_create(lab, distro, vmid=None, name=None, keep=False):
    """Create, provision, verify and seal a desktop template from a cloud image."""
    spec = DISTROS[distro]
    cfg = lab.cfg
    name = name or spec['name']
    lab.check_name(name)
    vmid = int(vmid) if vmid else lab.free_vmid(cfg.vmid_min)
    if not lab.in_range(vmid):
        raise LabError('VM ID outside range')
    image = '%s/%s' % (cfg.image_dir, spec['image'])
    q = shlex.quote
    algo, digest = image_digest(spec)
    line = q('%s  %s' % (digest, spec['image']))
    lab.note('checking image %s' % spec['image'])
    lab.host('install -d -m 700 %s && cd %s && (echo %s | %ssum -c --status - || '
             '(curl -fsSL --retry 3 -o %s.part %s && mv %s.part %s && echo %s | %ssum -c -))' % (
                 q(cfg.image_dir), q(cfg.image_dir), line, algo,
                 q(spec['image']), q(spec['url']), q(spec['image']), q(spec['image']), line, algo),
             timeout=1800)
    st = cfg.storage
    lab.note('creating VM %d (%s) on %s' % (vmid, name, st))
    lab.qm('create', vmid, '--name', name, '--tags', cfg.tag, '--memory', cfg.memory_mb, '--cores',
           max(cfg.cores, 4), '--cpu', 'host', '--machine', 'q35', '--bios', 'ovmf', '--ostype', 'l26',
           '--agent', 'enabled=1,fstrim_cloned_disks=1', '--scsihw', 'virtio-scsi-single',
           '--net0', 'virtio,bridge=%s' % cfg.bridge, '--vga', 'virtio', '--tablet', 1,
           '--serial0', 'socket', '--rng0', 'source=/dev/urandom', '--onboot', 0)
    try:
        lab.qm('set', vmid, '--efidisk0', '%s:1,efitype=4m,pre-enrolled-keys=0,format=qcow2' % st)
        if spec.get('installer') == 'ubiquity':
            _ubiquity_install(lab, vmid, name, spec, image)
        else:
            _cloud_first_boot(lab, vmid, spec, image)
        vm = {'vmid': vmid, 'name': name}
        lab.wait(vm, 'ssh', timeout=300)
        provision = LAB_DIR / spec['provision']
        lab.push(vm, provision, STAGED_SCRIPT, root=True, via='ssh')
        lab.push_secret(vm, cfg.password())
        env = 'WAVE_LAB_USER=%s' % q(cfg.guest_user)
        if cfg.apt_proxy:
            env += ' WAVE_APT_PROXY=%s' % q(cfg.apt_proxy)
        lab.note('provisioning (this takes a while; log: journalctl -u wave-lab-provision)')
        rc = lab.provision_unit(vm, STAGED_SCRIPT, 'install', env)
        if rc != 0:
            raise LabError('provisioning failed; inspect VM %d (kept)' % vmid)
        lab.note('rebooting into the desktop')
        lab.qm('reboot', vmid, '--timeout', 180, timeout=300)
        lab.wait(vm, 'agent', timeout=600)
        lab.note(lab.wait(vm, 'desktop', timeout=600))
        time.sleep(15)
        shot = cfg.dir / 'artifacts' / ('%s-provisioned.png' % name)
        lab.screenshot(vm, shot)
        lab.note('screenshot %s' % shot)
        template_seal(lab, vm, distro)
        return vmid
    except Exception:
        if not keep:
            lab.note('VM %d left in place for inspection; destroy it with: labctl destroy %d --template' % (
                vmid, vmid))
        raise


def template_seal(lab, vm, distro):
    """Seal a provisioned guest and convert it to a template."""
    spec, cfg, vmid = DISTROS[distro], lab.cfg, vm['vmid']
    if lab.status(vmid) != 'running':
        raise LabError('start %s first' % vm['name'])
    # A user-owned file in sticky /var/tmp cannot be rewritten by root (protected_regular).
    lab.guest_run(vm, 'rm -f %s' % STAGED_SCRIPT, root=True)
    lab.push(vm, LAB_DIR / spec['provision'], STAGED_SCRIPT, root=True)
    env = 'WAVE_LAB_USER=%s' % shlex.quote(cfg.guest_user)
    rc = lab.provision_unit(vm, STAGED_SCRIPT, 'seal', env, via='agent')
    if rc != 0:
        raise LabError('sealing failed; inspect VM %d (kept)' % vmid)
    lab.qm('shutdown', vmid, '--timeout', 180, '--forceStop', 1, timeout=300)
    current = lab.vm_config(vmid)
    stale = [k for k in ('ide2', 'ciuser', 'sshkeys', 'ipconfig0', 'ciupgrade') if k in current]
    if stale:
        lab.qm('set', vmid, '--delete', ','.join(stale))
    algo, digest = image_digest(spec)
    lab.qm('set', vmid, '--cores', cfg.cores, '--description',
           'Wave lab template %s from %s (%s %s), sealed %s' % (
               distro, spec['image'], algo, digest, datetime.date.today().isoformat()))
    lab.qm('template', vmid, timeout=300)
    lab.forget(vmid)


def _push_secret(self, vm, secret):
    rc, _, err, _ = self.guest_run(vm, 'umask 077; cat > /root/.wave-lab-password', root=True,
                                   stdin=(secret + '\n').encode())
    if rc != 0:
        raise LabError('could not stage the password: %s' % err.decode(errors='replace'))


def _provision_unit(self, vm, script, phase, env, via='auto'):
    """Run a provisioning phase as a transient unit so an SSH drop cannot kill it."""
    unit = 'wave-lab-provision-%s-%d' % (phase, int(time.time()))
    command = ('systemd-run --unit=%s --wait --collect --quiet -p TimeoutStartSec=infinity '
               '/usr/bin/env %s bash %s %s' % (unit, env, shlex.quote(script), shlex.quote(phase)))
    rc, _, err, _ = self.guest_run(vm, command, root=True, via=via, timeout=7200)
    log = self.guest_run(vm, 'journalctl -u %s -o cat --no-pager | tail -n 40' % unit, root=True, via=via)[1]
    sys.stderr.write(log.decode(errors='replace') + err.decode(errors='replace'))
    return rc


Lab.push_secret = _push_secret
Lab.provision_unit = _provision_unit


