LAB_DIR = Path(__file__).resolve().parent
NAME_RE = re.compile(r'^[a-z0-9][a-z0-9-]{0,48}$')
# ssh exits 255 for its own failures. Only these mean the remote command never ran.
SSH_NEVER_CONNECTED = re.compile(
    r'ssh: connect to host .* port \d+: |Connection timed out during banner exchange|'
    r'kex_exchange_identification|Could not resolve hostname|Host key verification failed|'
    r'REMOTE HOST IDENTIFICATION HAS CHANGED|No route to host|Network is unreachable|'
    r'Permission denied \(publickey')
SSH_HOSTKEY_PROBLEM = re.compile(r'Host key verification failed|REMOTE HOST IDENTIFICATION HAS CHANGED')
ABS_MAX = 0x7FFF


class LabError(Exception):
    pass


# --------------------------------------------------------------------------- config

def find_config(explicit=None):
    candidates = []
    if explicit:
        candidates.append(Path(explicit))
    elif os.environ.get('WAVE_LAB_CONFIG'):
        candidates.append(Path(os.environ['WAVE_LAB_CONFIG']))
    else:
        for start in (Path.cwd(), LAB_DIR):
            for parent in [start] + list(start.parents):
                candidates.append(parent / '.lab' / 'config.json')
    for path in candidates:
        if path.is_file():
            return path.resolve()
    raise LabError('no lab configuration found; set WAVE_LAB_CONFIG or create .lab/config.json '
                   'in a parent directory outside Git (see lab/README.md)')


class Config:
    DEFAULTS = {
        'clone_vmid_min': None, 'tag': 'wave-lab',
        'name_prefix': 'wave-', 'max_running': 3, 'guest_user': 'wave-lab', 'storage': 'local',
        'bridge': 'vmbr0', 'memory_mb': 4096, 'cores': 2, 'ssh_jump': None, 'apt_proxy': None,
        'image_dir': '/var/lib/vz/template/wave-lab', 'password_file': None, 'builder': {},
        'node': 'localhost',
    }

    def __init__(self, path):
        self.path = Path(path)
        self.dir = self.path.parent
        data = json.loads(self.path.read_text())
        missing = [k for k in ('host', 'ssh_key', 'vmid_min', 'vmid_max') if k not in data]
        if missing:
            raise LabError('configuration needs %s' % ', '.join(missing))
        self.data = dict(self.DEFAULTS)
        self.data.update(data)
        if self.data['clone_vmid_min'] is None:
            self.data['clone_vmid_min'] = self.data['vmid_min']

    def __getattr__(self, key):
        try:
            return self.data[key]
        except KeyError:
            raise AttributeError(key)

    def private(self, rel):
        path = Path(rel).expanduser()
        return path if path.is_absolute() else self.dir / path

    @property
    def state_dir(self):
        path = self.dir / 'state'
        path.mkdir(mode=0o700, exist_ok=True)
        return path

    def password(self):
        if not self.data.get('password_file'):
            raise LabError('configuration has no password_file')
        return self.private(self.password_file).read_text().strip()


# --------------------------------------------------------------------------- helpers

def helper_source():
    return (LAB_DIR / 'labhelper.py').read_bytes()


def helper_command(op, *args):
    packed = base64.b64encode(zlib.compress(helper_source(), 9)).decode()
    code = 'import base64,zlib;exec(zlib.decompress(base64.b64decode("%s")))' % packed
    return 'python3 -c %s %s' % (shlex.quote(code), ' '.join(shlex.quote(str(a)) for a in (op,) + args))


def ppm_to_png(data):
    """Convert a binary PPM (P6, maxval 255) to PNG using only the stdlib."""
    tokens = []
    pos = 2
    if not data.startswith(b'P6'):
        raise LabError('screendump returned neither PNG nor P6 PPM')
    while len(tokens) < 3:
        while data[pos:pos + 1].isspace():
            pos += 1
        if data[pos:pos + 1] == b'#':
            pos = data.index(b'\n', pos) + 1
            continue
        end = pos
        while not data[end:end + 1].isspace():
            end += 1
        tokens.append(int(data[pos:end]))
        pos = end
    pos += 1
    width, height, maxval = tokens
    if maxval != 255:
        raise LabError('unsupported PPM maxval %d' % maxval)
    stride = width * 3
    pixels = data[pos:pos + stride * height]
    raw = b''.join(b'\x00' + pixels[y * stride:(y + 1) * stride] for y in range(height))

    def chunk(kind, body):
        return struct.pack('>I', len(body)) + kind + body + struct.pack('>I', zlib.crc32(kind + body) & 0xFFFFFFFF)

    return (b'\x89PNG\r\n\x1a\n' + chunk(b'IHDR', struct.pack('>IIBBBBB', width, height, 8, 2, 0, 0, 0))
            + chunk(b'IDAT', zlib.compress(raw, 6)) + chunk(b'IEND', b''))


def image_size(data):
    if data.startswith(b'\x89PNG'):
        return struct.unpack('>II', data[16:24])
    if data.startswith(b'P6'):
        fields = re.match(rb'P6\s+(?:#[^\n]*\n\s*)*(\d+)\s+(\d+)', data)
        return int(fields.group(1)), int(fields.group(2))
    raise LabError('unknown screendump format')


def to_abs(value, size):
    if not 0 <= value < size:
        raise LabError('coordinate %d outside screen size %d' % (value, size))
    return int(round(value * ABS_MAX / max(size - 1, 1)))


KEY_ALIASES = {
    'enter': 'ret', 'return': 'ret', 'escape': 'esc', 'space': 'spc', 'super': 'meta_l', 'win': 'meta_l',
    'meta': 'meta_l', 'control': 'ctrl', 'del': 'delete', 'bksp': 'backspace', 'pageup': 'pgup',
    'pagedown': 'pgdn', 'altgr': 'alt_r', 'ins': 'insert',
}
CHAR_KEYS = {' ': ('spc', False), '\n': ('ret', False), '\t': ('tab', False)}
for _plain, _shifted, _code in [('-', '_', 'minus'), ('=', '+', 'equal'), ('[', '{', 'bracket_left'),
                                (']', '}', 'bracket_right'), ('\\', '|', 'backslash'), (';', ':', 'semicolon'),
                                ("'", '"', 'apostrophe'), ('`', '~', 'grave_accent'), (',', '<', 'comma'),
                                ('.', '>', 'dot'), ('/', '?', 'slash')]:
    CHAR_KEYS[_plain] = (_code, False)
    CHAR_KEYS[_shifted] = (_code, True)
for _digit, _shifted in zip('1234567890', '!@#$%^&*()'):
    CHAR_KEYS[_digit] = (_digit, False)
    CHAR_KEYS[_shifted] = (_digit, True)
for _letter in 'abcdefghijklmnopqrstuvwxyz':
    CHAR_KEYS[_letter] = (_letter, False)
    CHAR_KEYS[_letter.upper()] = (_letter, True)


def combo_keys(combo):
    """'ctrl-alt-t' -> QMP key list. A lone '-' or '+' is the key itself."""
    parts = [combo] if combo in ('-', '+') else re.split(r'(?<!^)[-+](?!$)', combo)
    keys = []
    for part in parts:
        name = KEY_ALIASES.get(part.lower(), part.lower())
        if len(part) == 1 and part in CHAR_KEYS:
            name = CHAR_KEYS[part][0]
        keys.append({'type': 'qcode', 'data': name})
    return keys


def type_commands(text, delay=0.03):
    commands = []
    for char in text:
        if char not in CHAR_KEYS:
            raise LabError('cannot type %r with a US keyboard map' % char)
        code, shift = CHAR_KEYS[char]
        keys = ([{'type': 'qcode', 'data': 'shift'}] if shift else []) + [{'type': 'qcode', 'data': code}]
        commands.append({'execute': 'send-key', 'arguments': {'keys': keys, 'hold-time': 30}})
        commands.append({'execute': 'sleep', 'seconds': delay})
    return commands


def has_tag(vm, tag):
    return tag in re.split(r'[;, ]+', vm.get('tags') or '')


# --------------------------------------------------------------------------- lab

class Lab:
    def __init__(self, cfg, verbose=False, quiet=False):
        self.cfg = cfg
        self.verbose = verbose
        self.quiet = quiet

    def note(self, message):
        if not self.quiet:
            sys.stderr.write('[labctl] %s\n' % message)

    # host ----------------------------------------------------------------
    def host(self, command, input=None, timeout=None, check=True):
        args = ['ssh', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10', '-o', 'ServerAliveInterval=15',
                self.cfg.host, command]
        if self.verbose:
            sys.stderr.write('[host] %s\n' % (command if len(command) < 300 else command[:120] + ' ...'))
        try:
            proc = subprocess.run(args, input=input, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                  stdin=None if input is not None else subprocess.DEVNULL, timeout=timeout)
        except subprocess.TimeoutExpired:
            raise LabError('host command timed out: %s' % command[:120])
        if check and proc.returncode != 0:
            raise LabError('host command failed (%d): %s\n%s' % (
                proc.returncode, command[:200], proc.stderr.decode(errors='replace').strip()))
        return proc

    def host_text(self, command, **kw):
        return self.host(command, **kw).stdout.decode(errors='replace')

    def qm(self, *args, **kw):
        return self.host_text('qm ' + ' '.join(shlex.quote(str(a)) for a in args), **kw)

    def helper(self, op, vmid, *args, input=None, timeout=120, check=True):
        return self.host(helper_command(op, vmid, *args), input=input, timeout=timeout, check=check)

    def helper_json(self, op, vmid, *args, **kw):
        return json.loads(self.helper(op, vmid, *args, **kw).stdout.decode())

    # inventory -----------------------------------------------------------
    def resources(self):
        # Live per-node lists; /cluster/resources lags behind new clones by seconds.
        found = []
        for kind in ('qemu', 'lxc'):
            for vm in json.loads(self.host_text('pvesh get /nodes/%s/%s --output-format json' % (
                    self.cfg.node, kind))):
                vm['type'] = kind
                vm['vmid'] = int(vm['vmid'])
                found.append(vm)
        return found

    def in_range(self, vmid):
        return self.cfg.vmid_min <= int(vmid) <= self.cfg.vmid_max

    def lab_vms(self):
        return sorted((vm for vm in self.resources() if vm.get('type') == 'qemu' and self.in_range(vm['vmid'])
                       and has_tag(vm, self.cfg.tag)), key=lambda vm: vm['vmid'])

    def resolve(self, ref):
        matches = [vm for vm in self.resources() if vm.get('type') == 'qemu'
                   and (str(vm['vmid']) == str(ref) or vm.get('name') == ref)]
        if not matches:
            raise LabError('no VM named %s' % ref)
        if len(matches) > 1:
            raise LabError('%s is ambiguous; use the VM ID' % ref)
        vm = matches[0]
        if not (self.in_range(vm['vmid']) and has_tag(vm, self.cfg.tag)
                and vm.get('name', '').startswith(self.cfg.name_prefix)):
            raise LabError('refusing to touch VM %s: not a %s-tagged %s* VM in %d-%d' % (
                vm['vmid'], self.cfg.tag, self.cfg.name_prefix, self.cfg.vmid_min, self.cfg.vmid_max))
        return vm

    def status(self, vmid):
        out = self.qm('status', vmid)
        return out.split(':', 1)[1].strip() if ':' in out else out.strip()

    def free_vmid(self, low=None):
        used = {int(vm['vmid']) for vm in self.resources()}
        for vmid in range(low or self.cfg.clone_vmid_min, self.cfg.vmid_max + 1):
            if vmid not in used:
                return vmid
        raise LabError('no free VM ID in range')

    def check_name(self, name):
        if not (name.startswith(self.cfg.name_prefix) and NAME_RE.match(name)):
            raise LabError('name must start with %s and use a-z, 0-9 and -' % self.cfg.name_prefix)
        if any(vm.get('name') == name for vm in self.resources()):
            raise LabError('a VM named %s already exists' % name)

    def running_lab_vms(self, exclude=None):
        return [vm for vm in self.lab_vms() if vm.get('status') == 'running' and vm['vmid'] != exclude]

    # lifecycle -----------------------------------------------------------
    def start(self, vm, force=False):
        if vm.get('template'):
            raise LabError('%s is a template; clone it first' % vm['name'])
        if self.status(vm['vmid']) == 'running':
            return
        running = self.running_lab_vms(exclude=vm['vmid'])
        if len(running) >= self.cfg.max_running and not force:
            raise LabError('%d lab VMs already running (%s); limit is %d. Stop one or pass --force.' % (
                len(running), ', '.join(v['name'] for v in running), self.cfg.max_running))
        self.forget(vm['vmid'])
        self.qm('start', vm['vmid'], timeout=180)

    def stop(self, vm, hard=False, timeout=90):
        if self.status(vm['vmid']) != 'running':
            return
        if hard:
            self.qm('stop', vm['vmid'], timeout=120)
        else:
            self.qm('shutdown', vm['vmid'], '--timeout', timeout, '--forceStop', 1, timeout=timeout + 60)

    def clone(self, template, name, vmid=None, memory=None, cores=None, snapshot='clean-desktop'):
        tpl = self.resolve(template)
        if not tpl.get('template'):
            raise LabError('%s is not a template' % template)
        self.check_name(name)
        vmid = int(vmid) if vmid else self.free_vmid()
        if not self.in_range(vmid):
            raise LabError('VM ID %d outside the lab range' % vmid)
        self.qm('clone', tpl['vmid'], vmid, '--name', name, '--full', 0, timeout=600)
        config = self.vm_config(vmid)
        uuid = re.search(r'uuid=([0-9a-fA-F-]+)', config.get('smbios1', ''))
        smbios = 'serial=%s,base64=1' % base64.b64encode(name.encode()).decode()
        if uuid:
            smbios = 'uuid=%s,%s' % (uuid.group(1), smbios)
        self.qm('set', vmid, '--tags', self.cfg.tag, '--memory', memory or self.cfg.memory_mb,
                '--cores', cores or self.cfg.cores, '--onboot', 0, '--smbios1', smbios)
        if snapshot:
            self.qm('snapshot', vmid, snapshot, '--description', 'Fresh linked clone of %s' % tpl['name'],
                    timeout=300)
        return vmid

    def destroy(self, vm, allow_template=False):
        if vm.get('template') and not allow_template:
            raise LabError('%s is a template; pass --template to destroy it' % vm['name'])
        if self.status(vm['vmid']) == 'running':
            self.qm('stop', vm['vmid'], timeout=120)
        self.qm('destroy', vm['vmid'], '--purge', 1, timeout=600)
        self.forget(vm['vmid'])

    def vm_config(self, vmid):
        config = {}
        for line in self.qm('config', vmid, '--current', 1).splitlines():
            if ': ' in line:
                key, value = line.split(': ', 1)
                config[key] = value
        return config

    # state ---------------------------------------------------------------
    def state_path(self, vmid):
        return self.cfg.state_dir / ('%s.json' % vmid)

    def known_hosts(self, vmid):
        return self.cfg.state_dir / ('%s.known_hosts' % vmid)

    def load_state(self, vmid):
        try:
            return json.loads(self.state_path(vmid).read_text())
        except (OSError, ValueError):
            return {}

    def save_state(self, vmid, state):
        path = self.state_path(vmid)
        path.write_text(json.dumps(state))
        path.chmod(0o600)

    def forget(self, vmid):
        for path in (self.state_path(vmid), self.known_hosts(vmid)):
            try:
                path.unlink()
            except OSError:
                pass

    # guest agent ---------------------------------------------------------
    def agent_ping(self, vmid):
        return self.helper('qga', vmid, json.dumps({'execute': 'guest-ping'}), 5, timeout=30,
                           check=False).returncode == 0

    def agent_ip(self, vmid):
        ifaces = self.helper_json('qga', vmid, json.dumps({'execute': 'guest-network-get-interfaces'}))
        candidates = []
        for iface in ifaces or []:
            name = iface.get('name', '')
            if name == 'lo' or name.startswith(('wg', 'tun', 'docker', 'virbr', 'br-', 'veth', 'wave')):
                continue
            for addr in iface.get('ip-addresses', []):
                ip = addr.get('ip-address', '')
                if addr.get('ip-address-type') == 'ipv4' and not ip.startswith(('127.', '169.254.')):
                    candidates.append((0 if name.startswith(('en', 'eth')) else 1, ip))
        if not candidates:
            raise LabError('guest agent reports no IPv4 address yet')
        return sorted(candidates)[0][1]

    NEIGHBOR_SWEEP = r'''
import ipaddress, re, socket, subprocess, sys, time
vmid = sys.argv[1]
conf = subprocess.check_output(['qm', 'config', vmid], text=True)
mac = re.search(r'^net0: \w+=([0-9A-Fa-f:]{17})', conf, re.M).group(1).lower()
bridge = re.search(r'^net0: .*bridge=([\w.-]+)', conf, re.M).group(1)
addr = subprocess.check_output(['ip', '-4', '-o', 'addr', 'show', bridge], text=True).split()[3]
sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
for _ in range(30):
    for ip in ipaddress.ip_network(addr, strict=False).hosts():
        try:
            sock.sendto(b'', (str(ip), 9))  # any packet makes the kernel ARP for it
        except OSError:
            pass
    time.sleep(2)
    for line in subprocess.check_output(['ip', '-4', 'neigh', 'show', 'dev', bridge], text=True).splitlines():
        if mac in line.lower() and 'FAILED' not in line:
            print(line.split()[0])
            sys.exit(0)
    time.sleep(3)
sys.exit(1)
'''

    def neighbor_ip(self, vmid):
        """IPv4 of a guest without an agent, from the host's neighbour table (same L2 bridge)."""
        proc = self.host('python3 -c %s %s' % (shlex.quote(self.NEIGHBOR_SWEEP), int(vmid)), timeout=200,
                         check=False)
        ip = proc.stdout.decode().strip()
        if proc.returncode != 0 or not re.match(r'^\d+\.\d+\.\d+\.\d+$', ip):
            raise LabError('guest MAC not found in the host neighbour table')
        return ip

    def refresh_ssh(self, vmid):
        ip = self.agent_ip(vmid)
        key = self.helper('read', vmid, '/etc/ssh/ssh_host_ed25519_key.pub').stdout.decode().split()
        if len(key) < 2 or key[0] != 'ssh-ed25519':
            raise LabError('could not read the guest SSH host key')
        self.pin_host_key(vmid, ip, key[0] + ' ' + key[1])
        return ip

    def pin_host_key(self, vmid, ip, key):
        known = self.known_hosts(vmid)
        known.write_text('%s %s\n' % (ip, key))
        known.chmod(0o600)
        state = self.load_state(vmid)
        state['ip'] = ip
        self.save_state(vmid, state)

    # guest ssh -----------------------------------------------------------
    def ssh_args(self, vmid, ip, tty=False, batch=True):
        args = ['ssh', '-i', str(self.cfg.private(self.cfg.ssh_key)), '-o', 'IdentitiesOnly=yes',
                '-o', 'BatchMode=%s' % ('yes' if batch else 'no'), '-o', 'UserKnownHostsFile=%s' % self.known_hosts(vmid),
                '-o', 'GlobalKnownHostsFile=/dev/null', '-o', 'StrictHostKeyChecking=yes',
                '-o', 'ConnectTimeout=5', '-o', 'ServerAliveInterval=10', '-o', 'ServerAliveCountMax=6',
                '-o', 'LogLevel=ERROR', '-t' if tty else '-T']
        if self.cfg.ssh_jump:
            args += ['-J', self.cfg.ssh_jump]
        return args + ['%s@%s' % (self.cfg.guest_user, ip)]

    def ssh_target(self, vmid, refresh=False):
        state = self.load_state(vmid)
        if refresh or not state.get('ip') or not self.known_hosts(vmid).exists():
            return self.refresh_ssh(vmid)
        return state['ip']

    def _ssh_once(self, vmid, ip, remote, stdin, timeout, stream):
        args = self.ssh_args(vmid, ip) + [remote]
        try:
            proc = subprocess.run(args, input=stdin, stdin=None if stdin is not None else subprocess.DEVNULL,
                                  stdout=None if stream else subprocess.PIPE, stderr=subprocess.PIPE,
                                  timeout=timeout)
        except subprocess.TimeoutExpired:
            return 124, b'', b'labctl: timed out\n'
        return proc.returncode, proc.stdout or b'', proc.stderr

    SSH_DOWN_SECONDS = 30

    def via_ssh(self, vmid, remote, stdin=None, timeout=None, stream=False, memo=False):
        """Returns (rc, out, err) or None when SSH never connected.

        With memo, a recent connection failure skips SSH for SSH_DOWN_SECONDS so
        consecutive commands under a blocked network do not each wait for timeouts.
        """
        state = self.load_state(vmid)
        if memo and state.get('ssh_down_until', 0) > time.time():
            self.note('SSH failed moments ago')
            return None
        try:
            ip = self.ssh_target(vmid)
        except LabError as exc:
            self.note('no SSH target: %s' % exc)
            return None
        for attempt in (0, 1):
            rc, out, err = self._ssh_once(vmid, ip, remote, stdin, timeout, stream)
            text = err.decode(errors='replace')
            if rc != 255 or not SSH_NEVER_CONNECTED.search(text):
                if self.load_state(vmid).pop('ssh_down_until', None) is not None:
                    state = self.load_state(vmid)
                    state.pop('ssh_down_until', None)
                    self.save_state(vmid, state)
                return rc, out, err
            if attempt == 0:
                # Address or host key may have changed (DHCP, rollback); ask the agent.
                try:
                    ip = self.refresh_ssh(vmid)
                except LabError:
                    break
        self.note('SSH unreachable (%s)' % text.strip().splitlines()[-1] if text.strip() else 'SSH unreachable')
        state = self.load_state(vmid)
        state['ssh_down_until'] = time.time() + self.SSH_DOWN_SECONDS
        self.save_state(vmid, state)
        return None

    # guest command -------------------------------------------------------
    def session_env(self, user):
        uid = '$(id -u %s)' % shlex.quote(user)
        return ('env XDG_RUNTIME_DIR=/run/user/%s DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%s/bus '
                'WAYLAND_DISPLAY=wayland-0 DISPLAY=:0 ' % (uid, uid))

    def guest_run(self, vm, command, root=False, session=False, via='auto', timeout=None, stdin=None,
                  stream=False):
        vmid = vm['vmid']
        user = self.cfg.guest_user
        env = self.session_env(user) if session else ''
        if via in ('auto', 'ssh'):
            if root:
                remote = 'sudo -n %sbash -c %s' % (env, shlex.quote(command))
            else:
                remote = '%sbash -c %s' % (env, shlex.quote(command))
            result = self.via_ssh(vmid, remote, stdin=stdin, timeout=timeout, stream=stream, memo=via == 'auto')
            if result is not None:
                return result + ('ssh',)
            if via == 'ssh':
                return 255, b'', b'labctl: SSH unreachable\n', 'ssh'
            self.note('falling back to the QEMU guest agent')
        inner = env + 'bash -c ' + shlex.quote(command) if env else command
        if root:
            argv = ['/usr/bin/env', 'HOME=/root', '/bin/bash', '-c', inner]
        else:
            argv = ['/usr/sbin/runuser', '-l', user, '-c', inner]
        limit = timeout or 600
        proc = self.helper('exec', vmid, limit, json.dumps(argv), input=stdin or b'', timeout=limit + 60,
                           check=False)
        if proc.returncode != 0:
            raise LabError('guest agent exec failed: %s' % proc.stderr.decode(errors='replace').strip())
        result = json.loads(proc.stdout.decode())
        out = base64.b64decode(result.get('out') or '')
        err = base64.b64decode(result.get('err') or '')
        if result.get('timeout'):
            err += b'labctl: guest command timed out and was killed\n'
        if stream:
            sys.stdout.buffer.write(out)
            sys.stdout.flush()
            out = b''
        return result.get('exitcode', 1), out, err, 'agent'

    def push(self, vm, local, remote, root=False, mode=None, via='auto'):
        data = Path(local).read_bytes()
        command = 'cat > %s' % shlex.quote(remote)
        if mode:
            command += ' && chmod %s %s' % (shlex.quote(mode), shlex.quote(remote))
        if via in ('auto', 'ssh'):
            remote_cmd = ('sudo -n bash -c %s' if root else 'bash -c %s') % shlex.quote(command)
            result = self.via_ssh(vm['vmid'], remote_cmd, stdin=data, timeout=600, memo=via == 'auto')
            if result is not None:
                if result[0] != 0:
                    raise LabError('push failed: %s' % result[2].decode(errors='replace').strip())
                return 'ssh'
            if via == 'ssh':
                raise LabError('SSH unreachable')
            self.note('falling back to the QEMU guest agent')
        self.helper('write', vm['vmid'], remote, input=data, timeout=600)
        fix = []
        if not root:
            fix.append('chown %s: %s' % (shlex.quote(self.cfg.guest_user), shlex.quote(remote)))
        if mode:
            fix.append('chmod %s %s' % (shlex.quote(mode), shlex.quote(remote)))
        if fix:
            rc, _, err, _ = self.guest_run(vm, ' && '.join(fix), root=True, via='agent')
            if rc != 0:
                raise LabError('push fix-up failed: %s' % err.decode(errors='replace'))
        return 'agent'

    def pull(self, vm, remote, local, root=False, via='auto'):
        if via in ('auto', 'ssh'):
            command = 'cat %s' % shlex.quote(remote)
            remote_cmd = ('sudo -n bash -c %s' if root else 'bash -c %s') % shlex.quote(command)
            result = self.via_ssh(vm['vmid'], remote_cmd, timeout=600, memo=via == 'auto')
            if result is not None:
                if result[0] != 0:
                    raise LabError('pull failed: %s' % result[2].decode(errors='replace').strip())
                Path(local).write_bytes(result[1])
                return 'ssh'
            if via == 'ssh':
                raise LabError('SSH unreachable')
            self.note('falling back to the QEMU guest agent')
        data = self.helper('read', vm['vmid'], remote, timeout=600).stdout
        Path(local).write_bytes(data)
        return 'agent'

    # display -------------------------------------------------------------
    def screendump(self, vm):
        return self.helper('screendump', vm['vmid'], timeout=60).stdout

    def screenshot(self, vm, out):
        data = self.screendump(vm)
        if not data.startswith(b'\x89PNG'):
            data = ppm_to_png(data)
        Path(out).write_bytes(data)
        return image_size(data)

    def qmp(self, vm, commands, timeout=120):
        return self.helper_json('qmp', vm['vmid'], json.dumps(commands), timeout=timeout)

    def keys(self, vm, combos, delay=0.1):
        commands = []
        for combo in combos:
            commands.append({'execute': 'send-key', 'arguments': {'keys': combo_keys(combo), 'hold-time': 60}})
            commands.append({'execute': 'sleep', 'seconds': delay})
        self.qmp(vm, commands)

    def type_text(self, vm, text, delay=0.03):
        commands = type_commands(text, delay)
        self.qmp(vm, commands, timeout=60 + len(text))

    def pointer(self, vm, x, y, button=None, double=False, size=None):
        width, height = size or image_size(self.screendump(vm))
        events = [{'type': 'abs', 'data': {'axis': 'x', 'value': to_abs(x, width)}},
                  {'type': 'abs', 'data': {'axis': 'y', 'value': to_abs(y, height)}}]
        commands = [{'execute': 'input-send-event', 'arguments': {'events': events}},
                    {'execute': 'sleep', 'seconds': 0.05}]
        for _ in range(2 if double else (1 if button else 0)):
            for down in (True, False):
                commands.append({'execute': 'input-send-event', 'arguments': {
                    'events': [{'type': 'btn', 'data': {'down': down, 'button': button}}]}})
                commands.append({'execute': 'sleep', 'seconds': 0.06})
        self.qmp(vm, commands)
        return width, height

    def scroll(self, vm, clicks):
        button = 'wheel-down' if clicks > 0 else 'wheel-up'
        commands = []
        for _ in range(abs(clicks)):
            for down in (True, False):
                commands.append({'execute': 'input-send-event', 'arguments': {
                    'events': [{'type': 'btn', 'data': {'down': down, 'button': button}}]}})
            commands.append({'execute': 'sleep', 'seconds': 0.05})
        self.qmp(vm, commands)

    # waiting -------------------------------------------------------------
    SESSION_CHECK = r'''
u=%(user)s; want=%(want)s
for s in $(loginctl list-sessions --no-legend | awk '{print $1}'); do
  info=$(loginctl show-session "$s" -p Name -p Type -p Active -p Class -p State | sort | tr '\n' ' ')
  case "$want:$info" in
    session:*"Active=yes Class=user Name=$u "*"Type=wayland"*)
      vt=$(loginctl show-session "$s" -p VTNr --value)
      [ -z "$vt" ] || [ "$vt" = 0 ] || [ "$(cat /sys/class/tty/tty0/active)" = "tty$vt" ] || continue
      pgrep -u "$u" -x gnome-shell >/dev/null && { echo "$s $info"; exit 0; } ;;
    desktop:*"Active=yes Class=user Name=$u "*"Type=wayland"*|desktop:*"Active=yes Class=user Name=$u "*"Type=x11"*)
      vt=$(loginctl show-session "$s" -p VTNr --value)
      [ -z "$vt" ] || [ "$vt" = 0 ] || [ "$(cat /sys/class/tty/tty0/active)" = "tty$vt" ] || continue
      shell=$(pgrep -u "$u" -l -x 'gnome-shell|plasmashell|cinnamon' | awk 'NR==1{print $2}')
      [ -n "$shell" ] && { echo "$s $info shell=$shell"; exit 0; } ;;
    session-any:*"Class=user Name=$u "*)
      echo "$s $info"; exit 0 ;;
    greeter:*"Class=greeter"*)
      echo "$s $info"; exit 0 ;;
  esac
done
exit 1
'''

    def wait(self, vm, what, timeout=300, interval=3):
        deadline = time.time() + timeout
        last = ''
        quiet, self.quiet = self.quiet, True  # expected failures while booting
        try:
            return self._wait(vm, what, deadline, interval)
        finally:
            self.quiet = quiet

    def _wait(self, vm, what, deadline, interval):
        last = ''
        while time.time() < deadline:
            try:
                if what == 'agent' and self.agent_ping(vm['vmid']):
                    return 'agent responding'
                if what == 'ip':
                    return self.agent_ip(vm['vmid'])
                if what == 'ssh':
                    result = self.via_ssh(vm['vmid'], 'true', timeout=30)
                    if result is not None and result[0] == 0:
                        return 'ssh ready at %s' % self.load_state(vm['vmid']).get('ip')
                if what in WAIT_SESSIONS:
                    want = WAIT_SESSIONS[what]
                    script = self.SESSION_CHECK % {'user': shlex.quote(self.cfg.guest_user), 'want': want}
                    rc, out, err, _ = self.guest_run(vm, script, root=True, via='agent', timeout=30)
                    if rc == 0:
                        return out.decode(errors='replace').strip()
                    last = (out + err).decode(errors='replace').strip()
            except LabError as exc:
                last = str(exc)
            time.sleep(interval)
        raise LabError('timed out waiting for %s on %s%s' % (what, vm['name'], (': ' + last[-500:]) if last else ''))

    # login modes ---------------------------------------------------------
    DETECT_DM = r'''
dm=$(basename "$(readlink -f /etc/systemd/system/display-manager.service 2>/dev/null)" .service)
case $dm in gdm|gdm3|sddm|lightdm) ;; *)
  dm=; for d in gdm gdm3 sddm lightdm; do systemctl is-active -q "$d" 2>/dev/null && dm=$d; done
  # openSUSE: display-manager-legacy starts the default-displaymanager alternative.
  [ -n "$dm" ] || dm=$(basename "$(readlink -f /etc/alternatives/default-displaymanager 2>/dev/null)") ;;
esac
case $dm in gdm3) dm=gdm ;; esac
'''

    def display_manager(self, vm):
        rc, out, err, _ = self.guest_run(vm, self.DETECT_DM + 'echo "$dm"', root=True, via='agent', timeout=30)
        dm = out.decode(errors='replace').strip()
        if rc != 0 or dm not in ('gdm', 'sddm', 'lightdm'):
            raise LabError('unknown display manager %r' % dm)
        return dm

    def login_mode(self, vm, mode, reboot=False):
        on = mode == 'autologin'
        user = shlex.quote(self.cfg.guest_user)
        script = 'set -e\n' + self.DETECT_DM + r'''
on=%(on)d; u=%(user)s
case $dm in
gdm)
  # Debian reads daemon.conf, Ubuntu and Fedora custom.conf.
  for f in /etc/gdm3/daemon.conf /etc/gdm3/custom.conf /etc/gdm/custom.conf; do [ -e "$f" ] && break; done
  [ "$on" = 1 ] && v=true || v=false
  printf '[daemon]\nAutomaticLoginEnable=%%s\nAutomaticLogin=%%s\n\n[security]\n\n[xdmcp]\n\n[chooser]\n\n[debug]\n' "$v" "$u" > "$f"
  echo "$f: AutomaticLoginEnable=$v" ;;
sddm)
  f=/etc/sddm.conf.d/zz-wave-lab-autologin.conf; install -d /etc/sddm.conf.d
  s=plasma; [ -e /usr/share/wayland-sessions/plasma.desktop ] || s=$(ls /usr/share/wayland-sessions /usr/share/xsessions 2>/dev/null | sed -n 's/\.desktop$//p' | head -n1)
  if [ "$on" = 1 ]; then printf '[Autologin]\nUser=%%s\nSession=%%s\nRelogin=false\n' "$u" "$s" > "$f"
  else printf '[Autologin]\nUser=\nSession=\n' > "$f"; fi
  # openSUSE's display-manager wrapper takes autologin from sysconfig.
  if [ -w /etc/sysconfig/displaymanager ]; then
    [ "$on" = 1 ] && a=$u || a=
    sed -i "s/^DISPLAYMANAGER_AUTOLOGIN=.*/DISPLAYMANAGER_AUTOLOGIN=\"$a\"/" /etc/sysconfig/displaymanager
  fi
  echo "$f: autologin=$on session=$s" ;;
lightdm)
  f=/etc/lightdm/lightdm.conf.d/90-wave-lab-autologin.conf; install -d /etc/lightdm/lightdm.conf.d
  [ "$on" = 1 ] && a=$u || a=
  printf '[Seat:*]\nautologin-user=%%s\nautologin-user-timeout=0\n' "$a" > "$f"
  # lightdm.conf is read last and would override the drop-in.
  [ -e /etc/lightdm/lightdm.conf ] && sed -i '/^autologin-user=/d' /etc/lightdm/lightdm.conf
  echo "$f: autologin-user=$a" ;;
*) echo "unsupported display manager: $dm" >&2; exit 3 ;;
esac
''' % {'on': on, 'user': user}
        rc, out, err, _ = self.guest_run(vm, script, root=True)
        if rc != 0:
            raise LabError('login-mode failed: %s' % err.decode(errors='replace'))
        if reboot:
            self.forget(vm['vmid'])
            self.qm('reboot', vm['vmid'], '--timeout', 120, timeout=200)
        return out.decode().strip()

    def dm_login(self, vm, timeout=180):
        """Log in at the greeter (GDM, SDDM or LightDM) by typing the private password."""
        self.wait(vm, 'greeter', timeout=timeout)
        dm = self.display_manager(vm)
        time.sleep(5 if dm != 'gdm' else 3)
        if dm == 'gdm':
            # The greeter starts on the user list; Enter selects the only user.
            self.keys(vm, ['ret'])
            time.sleep(2)
        # SDDM (Breeze) and LightDM (slick-greeter) preselect the only user with the
        # password field focused.
        self.type_text(vm, self.cfg.password())
        self.keys(vm, ['ret'])
        return self.wait(vm, 'desktop', timeout=timeout)

    gdm_login = dm_login


